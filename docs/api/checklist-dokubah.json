    "/api/v1/checklist-dokubah": {
      "get": {
        "tags": [
          "Checklist Dokubah"
        ],
        "summary": "List dokubah for the Gudang checklist",
        "description": "Needs checklist-dokubah.view. Same paging, search, filters and sorting as GET /api/v1/dokubah. hasChecklist tells whether Gudang saved a checklist for that dokubah.",
