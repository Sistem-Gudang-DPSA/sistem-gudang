                "required": [
                  "kepalaGroup",
                  "tglMulai",
                  "tglSelesai",
                  "kolomRealisasi",
                  "lines"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved, same body as GET",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
