      "put": {
        "tags": [
          "Checklist Dokubah"
        ],
        "summary": "Save the checklist of a dokubah",
        "description": "Needs checklist-dokubah.edit. Creates or replaces the whole checklist, lines included, in one transaction and answers like GET. Every line must have exactly kolomRealisasi realisasi entries, jumlah >= 0, dates YYYY-MM-DD, tglSelesai on or after tglMulai. Fully empty lines are dropped. 404 when the dokubah does not exist.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "1"
            },
            "required": true,
            "name": "dokubahId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kepalaGroup": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 191
                  },
                  "tglMulai": {
                    "type": "string",
                    "nullable": true,
                    "format": "date"
                  },
                  "tglSelesai": {
                    "type": "string",
                    "nullable": true,
                    "format": "date"
                  },
                  "kolomRealisasi": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 50
