                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "kodeDokubah": {
                                "type": "string",
                                "description": "The dokubah noSpk"
                              },
                              "namaClient": {
                                "type": "string"
                              },
                              "namaItem": {
                                "type": "string",
                                "description": "Project name from tracking, empty when unknown"
                              },
                              "noSpk": {
                                "type": "string"
                              },
                              "dokubahId": {
                                "type": "number"
                              },
                              "hasChecklist": {
