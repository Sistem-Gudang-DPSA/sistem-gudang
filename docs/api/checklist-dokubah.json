    "/api/v1/checklist-dokubah/{dokubahId}": {
      "get": {
        "tags": [
          "Checklist Dokubah"
        ],
        "summary": "Get the checklist of a dokubah",
        "description": "Needs checklist-dokubah.view. checklist is null until the first save. 404 when the dokubah does not exist. Selisih is typed by the user and stored as typed (max 50, nullable).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "1"
            },
            "required": true,
            "name": "dokubahId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Dokubah header and checklist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "dokubah": {
                          "type": "object",
                          "properties": {
                            "kodeDokubah": {
                              "type": "string",
                              "description": "The dokubah noSpk"
                            },
                            "namaClient": {
                              "type": "string"
                            },
                            "namaItem": {
                              "type": "string",
                              "description": "Project name from tracking, empty when unknown"
                            },
                            "noSpk": {
                              "type": "string"
                            },
                            "id": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "kodeDokubah",
                            "namaClient",
                            "namaItem",
                            "noSpk",
                            "id"
                          ]
                        },
                        "checklist": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "kepalaGroup": {
                              "type": "string",
                              "nullable": true,
                              "maxLength": 191
                            },
                            "tglMulai": {
                              "type": "string",
                              "nullable": true,
                              "format": "date"
                            },
                            "tglSelesai": {
                              "type": "string",
                              "nullable": true,
                              "format": "date"
                            },
                            "kolomRealisasi": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 50
                            },
                            "lines": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "material": {
                                    "type": "string",
                                    "maxLength": 191
                                  },
                                  "dokubah": {
                                    "type": "string",
                                    "maxLength": 100
                                  },
                                  "selisih": {
                                    "type": "string",
                                    "nullable": true,
                                    "maxLength": 50
                                  },
                                  "realisasi": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "tanggal": {
                                          "type": "string",
                                          "nullable": true,
                                          "format": "date"
                                        },
                                        "pengambil": {
                                          "type": "string",
                                          "maxLength": 191
                                        },
                                        "jumlah": {
                                          "type": "number",
                                          "minimum": 0,
                                          "maximum": 1000000
                                        }
                                      },
                                      "required": [
                                        "tanggal",
                                        "pengambil",
                                        "jumlah"
                                      ]
                                    }
                                  },
                                  "keterangan": {
                                    "type": "string",
                                    "nullable": true,
                                    "maxLength": 500
                                  }
                                },
                                "required": [
                                  "material",
                                  "dokubah",
                                  "selisih",
                                  "realisasi",
                                  "keterangan"
                                ]
                              },
                              "maxItems": 500
                            },
                            "updatedAt": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "kepalaGroup",
                            "tglMulai",
                            "tglSelesai",
                            "kolomRealisasi",
                            "lines",
                            "updatedAt"
                          ]
                        }
                      },
                      "required": [
                        "dokubah",
                        "checklist"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
