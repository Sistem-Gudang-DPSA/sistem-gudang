                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "material": {
                          "type": "string",
                          "maxLength": 191
                        },
                        "dokubah": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "selisih": {
                          "type": "string",
                          "nullable": true,
                          "maxLength": 50
                        },
                        "realisasi": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "tanggal": {
                                "type": "string",
                                "nullable": true,
                                "format": "date"
                              },
                              "pengambil": {
                                "type": "string",
                                "maxLength": 191
                              },
                              "jumlah": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1000000
                              }
                            },
                            "required": [
                              "tanggal",
                              "pengambil",
                              "jumlah"
                            ]
                          }
                        },
                        "keterangan": {
                          "type": "string",
                          "nullable": true,
                          "maxLength": 500
                        }
