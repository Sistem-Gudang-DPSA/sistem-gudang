                "noSpk",
                "client",
                "totalAnggaran",
                "status"
              ]
            },
            "required": false,
            "name": "sortBy",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            },
            "required": false,
            "name": "sortDir",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Checklist list",
