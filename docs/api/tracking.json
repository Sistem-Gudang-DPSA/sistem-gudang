{
  "paths": {
    "/api/v1/tracking/spk": {
      "get": {
        "tags": [
          "Dokubah"
        ],
        "summary": "List SPK numbers with their client",
        "description": "Readable by every authenticated role without dokubah.view, including custom roles with no permissions, for Daftar Proyek. Source of the SPK and its client for dokubah, SPK internal, outbound, material requests and client returns, and for the dropdowns of Barang Keluar. Read from the tracking system and kept in memory for TRACKING_CACHE_TTL_MINUTES (default 30), then reloaded in the background; refresh=1 reloads it first (the refresh button). search matches noSpk or client, case-insensitively. client keeps only the SPK of that client name (exact, case-insensitive, trimmed), and can be combined with search. limit is optional; without it every SPK is returned. Applied after client. projectName is included when the tracking source sends it. tanggalMasuk is the SPK masuk date from tracking (spk.tanggal_masuk), passed through as is, null when missing. Products are not listed here, use GET /api/v1/tracking/spk/{noSpk}.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "PT Maju Jaya"
            },
            "required": false,
            "name": "client",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "50"
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "required": false,
            "name": "refresh",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "SPK list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "noSpk": {
                            "type": "string"
                          },
                          "client": {
                            "type": "string"
                          },
                          "projectName": {
                            "type": "string"
                          },
                          "tanggalMasuk": {
                            "type": "string",
                            "nullable": true,
                            "description": "SPK masuk date (YYYY-MM-DD) from tracking, null when tracking has none",
                            "example": "2026-01-05"
                          }
                        },
                        "required": [
                          "noSpk",
                          "client",
                          "tanggalMasuk"
                        ]
                      }
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Authenticated, but not authorized",
