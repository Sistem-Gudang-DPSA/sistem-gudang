    "/api/v1/tracking/spk/{noSpk}": {
      "get": {
        "tags": [
          "Dokubah"
        ],
        "summary": "Get one SPK with its client and products",
        "description": "Needs dokubah.view. noSpk is matched exactly. Numbers can contain slashes, so send them URL-encoded (encodeURIComponent). products are what tracking knows for that SPK, merged when tracking holds the same number more than once, and may be empty: then Barang Keluar only offers Stok. outbound itemName is not validated against products. An SPK missing from the cached list is looked up in tracking directly, so a new SPK is found at once. 404 when the SPK is unknown.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "SPK-2026-001"
            },
            "required": true,
            "name": "noSpk",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "SPK found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "noSpk": {
                          "type": "string"
                        },
                        "client": {
                          "type": "string"
                        },
                        "projectName": {
                          "type": "string"
                        },
                        "products": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "qty": {
                                "type": "number"
                              },
                              "unit": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "qty",
                              "unit"
                            ]
                          }
                        }
                      },
                      "required": [
                        "noSpk",
                        "client",
                        "projectName",
                        "products"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
